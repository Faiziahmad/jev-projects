# Copy to .env and fill in. Never commit .env.
# API keys for Anthropic and Google are NOT here: they are stored as encrypted
# n8n credentials (Settings > Credentials), set up once in the n8n UI.

# --- Server -------------------------------------------------------------------
# Public hostname pointing at this server (DNS A record). Caddy gets the TLS cert.
N8N_DOMAIN=bot.brightsmiledental.example
# Pin the version you tested. The template was built and tested on 2.40.7.
N8N_VERSION=2.40.7
# Generate with: openssl rand -hex 32   (back it up: credentials can't be decrypted without it)
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# IANA timezone of the clinic. Drives slot times, reminders and the sheet timestamps.
CLINIC_TIMEZONE=America/New_York

# --- Twilio (console.twilio.com) -------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used ONLY to verify that webhooks really come from Twilio. Sending uses the n8n Twilio credential.
TWILIO_AUTH_TOKEN=
# The clinic's WhatsApp sender, E.164 without "whatsapp:". Sandbox: +14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886
# Leave true in production. Set false ONLY for local tests without a public URL.
TWILIO_VALIDATE_SIGNATURE=true
# Content SID (HX...) of the approved reminder template. Empty = plain text (sandbox / testing only).
TWILIO_REMINDER_CONTENT_SID=

# --- Clinic -------------------------------------------------------------------
# Staff member's personal WhatsApp that receives handoff alerts and sends #reply commands.
# Must be a DIFFERENT number from the patient you test with.
STAFF_WHATSAPP_NUMBER=+15550102040

# --- Google ---------------------------------------------------------------------
# Calendar settings > Integrate calendar > Calendar ID. Must look like an email;
# "primary" is rejected by n8n's Google Calendar node.
GOOGLE_CALENDAR_ID=c_0123456789abcdef@group.calendar.google.com
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
